# ── Slack (required) ──────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ── Anthropic (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here

# ── Supabase (required) ───────────────────────────────────────────────────────
# Used for: KV store (rate limiting + approval state) and knowledge base table
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Slack channels (required) ─────────────────────────────────────────────────
IT_REQUESTS_CHANNEL=#it-requests
IT_APPROVALS_CHANNEL=#it-approvals
INCIDENTS_CHANNEL=#incidents

# ── Jira (optional — bot works without it) ────────────────────────────────────
JIRA_URL=https://yoursite.atlassian.net
JIRA_EMAIL=you@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=IT

# ── Confluence (optional — bot works without it) ──────────────────────────────
# Used for: KB article search (injected into Claude prompt) and incident pages.
# If Confluence is on the same Atlassian instance as Jira, only set CONFLUENCE_SPACE_KEY.
# The bot will reuse JIRA_URL, JIRA_EMAIL, and JIRA_API_TOKEN automatically.
# Only set CONFLUENCE_URL / CONFLUENCE_EMAIL / CONFLUENCE_API_TOKEN if Confluence
# is on a DIFFERENT Atlassian instance.
CONFLUENCE_SPACE_KEY=IT
# CONFLUENCE_URL=https://yoursite.atlassian.net
# CONFLUENCE_EMAIL=you@email.com
# CONFLUENCE_API_TOKEN=your-api-token

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# Max AI-powered requests per user per day. Resets at midnight UTC.
RATE_LIMIT_PER_DAY=5
